# ESP-Mosaico V1.2 - ESP32-S31NRV16: 16 MB flash, 16 MB in-package PSRAM
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y

# Same IDF 6.1 workaround as the ESP32-S31 Korvo board
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=n
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=n

# Board Manager devices
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES8389_SUPPORT=n

# Type-C is USB HS OTG: TinyUSB CDC console instead of the IDF console
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_USB_HS_CONSOLE_USB_CDC_AUTO_DOWNLOAD=y
CONFIG_USB_HS_CONSOLE_USB_CDC_AUTO_INIT=y
